# ---------------------------------------------------------------------------
# Zion Groups of Companies - environment configuration
# Copy this file to .env (same folder) and edit the values for your host.
# Any value left out falls back to the development default in config.php.
# ---------------------------------------------------------------------------

# development | production
APP_ENV=development

# true  -> errors are printed on screen (development)
# false -> errors go to storage/logs/php-error.log instead (production)
APP_DEBUG=true

# Canonical origin used for sitemaps, canonical tags and outbound links.
# No trailing slash. Example: https://ziongroups.com.gh
APP_URL=http://127.0.0.1:8080

# ------------------------------------------------------------------ database
# cPanel / shared hosting: DB_HOST=localhost and the DB_NAME / DB_USER given
# by "MySQL Databases" (names are often prefixed with your cPanel user).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=velora_shop
DB_USER=root
DB_PASS=

# ------------------------------------------------------------------ payments
# Leave empty while Paystack runs in simulation mode.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ----------------------------------------------------------------- mail/email
# log  -> write messages to storage/logs/mail.log (default, no account needed)
# php  -> PHP mail() / sendmail
# smtp -> SMTP submission using the settings below
MAIL_MAILER=log
MAIL_FROM=orders@ziongroups.com.gh
MAIL_FROM_NAME=Zion Groups of Companies
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPT=tls

# ---------------------------------------------------------------- operations
ADMIN_EMAIL=admin@ziongroups.com.gh
LOW_STOCK_THRESHOLD=5

# Secret required by /sync_deploy.php and /deploy.php (browser mode only).
# Leave commented out to disable browser deploys entirely (CLI still works).
# Generate: php -r "echo bin2hex(random_bytes(32));"
# DEPLOY_TOKEN=

# ------------------------------------------------------- telegram intake
# Product batches (sheet + photos) arrive from a Telegram bot. Create the
# bot with @BotFather, put its token here, generate a webhook secret, and
# list your own numeric chat id (ask @userinfobot on Telegram). Then run:
#   php tools/tg_set_webhook.php
# TG_BOT_TOKEN=
# TG_WEBHOOK_SECRET=
# TG_ALLOWED_CHAT_IDS=
