# Zion Groups of Companies - Apache configuration
# Requires: mod_rewrite, mod_headers (both enabled by default in XAMPP/LAMP).

Options -Indexes
DirectoryIndex index.php

# --------------------------------------------------------------- security
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Never serve configuration, dumps or logs.
<FilesMatch "^(\.env|\.env\..*|.*\.log|.*\.pid|schema\.sql|seed\.sql|composer\.(json|lock)|\.git.*)$">
    Require all denied
</FilesMatch>

# --------------------------------------------------------------- routing
RewriteEngine On

# Hidden paths are never content (.git history, .user.ini, .env, editor dirs)
# except ACME/.well-known for certificate issuance.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]

# Everything under storage/ is private except user uploads.
RewriteRule ^storage/(?!uploads/) - [F,L]

# Helper scripts are CLI-only; the pre-flight page is the single exception.
RewriteRule ^tools/doctor\.php$ - [L]
RewriteRule ^tools/ - [F,L]

# Dynamic crawler files (correct absolute URLs for the live host).
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# ------------------------------------------------------------- HTTPS only
# OFF by default: uncommenting this 301s every non-HTTPS request to
# https://, which only works once a trusted certificate is actually installed.
#
# Verify from a network that is NOT this development machine first - local DNS
# can answer 127.0.0.1 for the domain, in which case these probes only see
# XAMPP's own certificate:
#     curl -sI https://yourdomain.com | head -3   # expect HTTP/1.1 200
#     curl -sI http://yourdomain.com  | head -3   # expect 301 + Location: https
#
# The localhost exemption keeps local Apache working over plain HTTP; the
# README's `php -S` dev server ignores .htaccess entirely.
# RewriteCond %{HTTPS} !=on
# RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
