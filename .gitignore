# environment / secrets
.env
.env.*
!.env.example

# runtime storage: keep the folders (and the upload .htaccess) in git,
# never their contents
/storage/logs/*
!/storage/logs/.gitkeep
/storage/uploads/*
!/storage/uploads/.htaccess
!/storage/uploads/.gitkeep

